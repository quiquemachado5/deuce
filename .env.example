# Real bundled archive is the default. No credentials are needed for offline work.
NEXT_PUBLIC_USE_MOCK_DATA=false
# Optional public ownership tokens emitted only as search-engine verification meta tags.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Optional server-only credentials for the existing remote archive.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Connect a private Vercel Blob store. Vercel injects BLOB_STORE_ID and OIDC
# credentials in deployments; BLOB_READ_WRITE_TOKEN is used by local seeding.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Keep a 200 MB margin below the 1 GB Hobby storage allowance.
DEUCE_ARCHIVE_MAX_BYTES=800000000
# TENNIS_API_KEY=
# Keep enough daily calls for recovery and the next scheduled refresh. Every
# provider operation shares this reserve and stops before crossing it.
DEUCE_PROVIDER_MIN_REMAINING=200
# Independent daily ceiling across refresh, history, enrichment and on-demand details.
DEUCE_PROVIDER_DAILY_MAX_CALLS=400
# CRON_SECRET=
# Optional HMAC salt for anonymized security-event actor hashes.
# SECURITY_LOG_SALT=
