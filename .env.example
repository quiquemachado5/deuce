# Real bundled archive is the default. No credentials are needed for offline work.
NEXT_PUBLIC_USE_MOCK_DATA=false
# Optional server-only credentials for the existing remote archive.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# TENNIS_API_KEY=
# CRON_SECRET=
# Optional hard stop for the archive relation (defaults to 1.5 GB).
# DEUCE_ARCHIVE_MAX_BYTES=1500000000
