# Real bundled archive is the default. No credentials are needed for offline work.
NEXT_PUBLIC_USE_MOCK_DATA=false
# Optional public ownership tokens emitted only as search-engine verification meta tags.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Optional server-only credentials for the existing remote archive.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Enable the indexed Postgres game store after applying the Supabase migration.
# DEUCE_GAME_STORE_BACKEND=supabase
# Production uses the persistent filesystem volume mounted by Compose.
# Keep this below 70% of the VPS filesystem so builds, logs and backups retain headroom.
DEUCE_ARCHIVE_DIR=/app/.deuce-archive
DEUCE_ARCHIVE_MAX_BYTES=40000000000
# Preferred: completed results in bulk (50 free requests/day via RapidAPI).
# TENNIS_RESULTS_API_KEY=
# Recheck the last settled days on every run (2-14) to recover short outages.
DEUCE_RESULT_REPAIR_DAYS=7
# Optional third verifier. The two-source CSV + Tennis API path works without it.
# POINT_TENNIS_API_KEY=
# Fallback: finished fixtures and stable match IDs only; no live polling.
# TENNIS_API_KEY=
DEUCE_PIPELINE_HOUR_UTC=9
DEUCE_PIPELINE_MINUTE_UTC=20
# Keep enough daily calls for recovery and the next scheduled refresh. Every
# provider operation shares this reserve and stops before crossing it.
DEUCE_PROVIDER_MIN_REMAINING=10
# Independent daily ceiling across refresh, history, enrichment and on-demand details.
DEUCE_PROVIDER_DAILY_MAX_CALLS=90
DEUCE_PROVIDER_DAILY_ONLY=1
# CRON_SECRET=
# Optional HMAC salt for anonymized security-event actor hashes.
# SECURITY_LOG_SALT=
