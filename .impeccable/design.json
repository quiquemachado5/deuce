      "css": ".ds-nav{display:flex;gap:24px;font-family:var(--font-interface);}.ds-nav a{position:relative;display:flex;align-items:center;min-height:44px;font-size:13px;font-weight:500;white-space:nowrap;color:var(--muted);text-decoration:none;transition:color var(--speed)}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--ink)}.ds-nav a[aria-current=page]::after{content:\"\";position:absolute;bottom:0;left:0;right:0;height:3px;border-radius:999px;background:var(--ink)}.ds-nav a:focus-visible{outline:2px solid var(--focus);outline-offset:4px}"
