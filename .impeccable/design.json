      "css": ".ds-text-button{background:none;color:var(--ink);border:0;padding:8px 0;text-decoration:underline;text-underline-offset:4px;font-family:var(--font-interface);font-size:13px;cursor:pointer;transition:color var(--speed)}.ds-text-button:focus-visible{outline:2px solid var(--focus);outline-offset:4px}"
    },
