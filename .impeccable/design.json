      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font-family:var(--font-interface);font-size:12px;font-weight:500;color:var(--ink-soft)}.ds-field input{width:100%;min-width:0;height:44px;padding:0 16px;border:1px solid var(--line);border-radius:16px;background:var(--bg);color:var(--ink);font:400 14px var(--font-interface);transition:border-color var(--speed)}.ds-field input::placeholder{color:var(--muted)}.ds-field input:hover{border-color:var(--line-strong)}.ds-field input:focus-visible{outline:2px solid var(--focus);outline-offset:4px}"
