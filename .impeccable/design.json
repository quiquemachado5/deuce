      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 24px;border:0;border-radius:999px;background:var(--ink);color:var(--bg-raised);font-family:var(--font-interface);font-size:14px;font-weight:600;cursor:pointer;transition:opacity var(--speed)}.ds-button:hover{opacity:.8}.ds-button:focus-visible{outline:2px solid var(--focus);outline-offset:4px}.ds-button:disabled{opacity:.5;cursor:default}"
    },
