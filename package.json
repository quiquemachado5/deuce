{
  "name": "deuce-slam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node build/prepare-local-snapshot.mjs && next dev",
    "build": "node build/run-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./build/register.mjs --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "data:prepare": "npm run data:rebuild",
    "data:rebuild": "node --import ./build/register.mjs --import tsx build/prepare-records.ts",
    "data:ensure": "node build/ensure-snapshot.mjs",
    "data:local": "node build/prepare-local-snapshot.mjs",
    "data:snapshot:export": "node build/snapshot-artifact.mjs export",
    "data:snapshot:restore": "node build/snapshot-artifact.mjs restore --target=.deuce-cache/reading",
    "data:verify": "node --import ./build/register.mjs --import tsx build/verify-archive.ts",
    "data:evidence": "node --import ./build/register.mjs --import tsx build/verify-evidence.ts",
    "data:restore-drill": "node build/restore-drill.mjs",
    "data:wta:backfill": "node --env-file=.env.local --import ./build/register.mjs --import tsx build/backfill-wta-local.ts",
    "data:wta:backfill:historical": "npm run data:wta:backfill -- --history-only --through-year=2019",
    "storage:seed": "node --import ./build/register.mjs --import tsx build/seed-blob-archive.ts",
    "media:verify": "node --import ./build/register.mjs --import tsx build/audit-tournament-media.ts",
    "media:players": "node build/discover-player-photos.mjs --scan=250 --max=100",
    "media:wta": "node build/import-wta-player-photos.mjs --review-only --limit=50",
    "media:wta:bios": "node build/import-wta-player-bios.mjs",
    "budgets:verify": "node build/audit-budgets.mjs && node build/audit-public-assets.mjs",
    "monitor:check": "node ops/monitor.mjs --check-only",
    "vps:preflight": "node ops/vps/preflight.mjs",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run media:verify && npm run data:verify && npm run budgets:verify",
    "data:verify-publication": "node --import ./build/register.mjs --import tsx build/verify-publication-packs.ts",
    "media:wta:discover": "node build/discover-player-photos.mjs --tour=wta --scan=400 --max=100",
    "media:wta:bios:local": "node build/index-wta-player-bios.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/blob": "2.8.2",
    "lucide-react": "^0.441.0",
    "next": "16.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
