{
  "name": "deuce-slam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run media:verify && node --import ./build/register.mjs --import tsx build/prepare-records.ts && node --import ./build/register.mjs --import tsx build/prepare-player-bio.ts && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./build/register.mjs --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "data:prepare": "node --import ./build/register.mjs --import tsx build/prepare-records.ts",
    "data:verify": "node --import ./build/register.mjs --import tsx build/verify-archive.ts",
    "data:evidence": "node --import ./build/register.mjs --import tsx build/verify-evidence.ts",
    "data:restore-drill": "node build/restore-drill.mjs",
    "media:verify": "node --import ./build/register.mjs --import tsx build/audit-tournament-media.ts",
    "media:players": "node build/discover-player-photos.mjs --scan=250 --max=100",
    "media:wta": "node build/import-wta-player-photos.mjs --limit=50",
    "media:wta:bios": "node build/import-wta-player-bios.mjs",
    "monitor:check": "node ops/monitor.mjs --check-only",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run media:verify && npm run data:verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.441.0",
    "next": "16.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.12",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  }
}
