{
  "name": "deuce-slam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node build/prepare-local-snapshot.mjs && next dev",
    "build": "node build/run-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./build/register.mjs --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test tests/browser/shell.spec.ts tests/browser/archive.spec.ts tests/browser/circuit-flow.spec.ts",
    "data:prepare": "npm run data:rebuild",
    "data:rebuild": "node --import ./build/register.mjs --import tsx build/prepare-records.ts",
    "data:ensure": "node build/ensure-snapshot.mjs",
    "data:local": "node build/prepare-local-snapshot.mjs",
    "data:snapshot:export": "node build/snapshot-artifact.mjs export",
    "data:snapshot:restore": "node build/snapshot-artifact.mjs restore --target=.deuce-cache/reading",
    "data:snapshot:rollback": "node build/snapshot-artifact.mjs rollback --target=.deuce-cache/reading",
    "data:verify": "node --import ./build/register.mjs --import tsx build/verify-archive.ts",
    "data:evidence": "node --import ./build/register.mjs --import tsx build/verify-evidence.ts",
    "data:restore-drill": "node build/restore-drill.mjs",
    "data:wta:backfill": "node --env-file=.env.local --import ./build/register.mjs --import tsx build/backfill-wta-local.ts",
    "data:wta:backfill:historical": "npm run data:wta:backfill -- --history-only --through-year=2019",
    "data:wta:derive": "node --import ./build/register.mjs --import tsx build/derive-wta-cohorts.ts",
    "data:wta:audit": "node --import ./build/register.mjs --import tsx build/audit-wta-cohorts.ts",
    "data:integrity-queue": "node --import ./build/register.mjs --import tsx build/build-integrity-repair-queue.ts",
    "data:repair:modern": "node --env-file=.env.local --import ./build/register.mjs --import tsx build/repair-modern-results.ts",
    "storage:seed": "node --import ./build/register.mjs --import tsx build/seed-archive.ts",
    "media:verify": "node --import ./build/register.mjs --import tsx build/audit-tournament-media.ts && node --import ./build/register.mjs --import tsx build/audit-photo-rights.ts",
    "media:players": "node build/discover-player-photos.mjs --scan=250 --max=100",
    "media:thumbnails": "node build/generate-player-avatar-thumbnails.mjs",
    "media:wta": "node build/import-wta-player-photos.mjs --review-only --limit=50",
    "media:wta:bios": "node build/import-wta-player-bios.mjs",
    "budgets:verify": "node build/audit-budgets.mjs && node build/audit-public-assets.mjs",
    "performance:verify": "node --import ./build/register.mjs --import tsx build/verify-performance.ts",
    "monitor:check": "node ops/monitor.mjs --check-only",
    "vps:preflight": "node ops/vps/preflight.mjs",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run media:verify && npm run data:verify && npm run data:wta:audit && npm run data:integrity-queue && npm run performance:verify && npm run budgets:verify",
    "data:verify-publication": "node --import ./build/register.mjs --import tsx build/verify-publication-packs.ts",
    "media:wta:discover": "node build/discover-player-photos.mjs --tour=wta --scan=400 --max=100",
    "media:wta:bios:local": "node build/index-wta-player-bios.mjs",
    "assets:brand": "node build/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.441.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
