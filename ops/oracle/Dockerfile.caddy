FROM caddy:2.10.2-builder-alpine@sha256:4cff3ae272ea05842adb4546e35961e4947aeea65f80fa1eb62a35b960e84971 AS builder
ARG RATE_LIMIT_VERSION=5625512f24f6f59d6f64fb3aafe5eecff0b286db
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@${RATE_LIMIT_VERSION}

FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
ARG DEUCE_CADDY_SOURCE_SHA256=unknown
LABEL org.opencontainers.image.source="https://github.com/quiquemachado5/deuce" \
      org.opencontainers.image.description="Caddy 2.10.2 with the pinned DEUCE rate-limit module" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${DEUCE_CADDY_SOURCE_SHA256}"
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
