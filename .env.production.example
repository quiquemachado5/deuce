# Use a DNS name that resolves to the server. A free sslip.io hostname works:
# deuce.203-0-113-10.sslip.io
DEUCE_HOST=deuce.example.com
NEXT_PUBLIC_SITE_ORIGIN=https://deuce.example.com
DEUCE_MONITOR_URL=https://deuce.example.com
DEUCE_LOG_DIR=/opt/deuce/logs

# Server-only secrets. Generate CRON_SECRET with: openssl rand -hex 32
TENNIS_API_KEY=replace-with-provider-key
CRON_SECRET=replace-with-random-secret
WTA_BACKFILL_SECRET=replace-with-another-random-secret

# Keep headroom for Docker images, builds and rotating backups on a 64 GB VPS.
DEUCE_ARCHIVE_MAX_BYTES=40000000000

# Optional immutable reading snapshot. The manifest records its source commit,
# dataset version and SHA-256 for every compressed artifact.
# DEUCE_SNAPSHOT_MANIFEST_URL=https://storage.example/deuce/snapshot-manifest.json
# DEUCE_EXPECTED_SNAPSHOT_COMMIT=

# Required offsite backup destination understood by rclone (S3, B2, SFTP...).
# Configure the matching rclone credentials on the host before the backup timer runs.
DEUCE_BACKUP_REMOTE=s3:deuce-backups/production
